# DO NOT EDIT BY HAND. Generate frontend/.env.local from current SSM values:
#   make -C infra gen-frontend-env
#
# (or as a side-effect of `make -C infra dev-frontend` or `make -C infra sync-frontend`)

VITE_API_URL=https://CHANGE-ME.execute-api.us-west-2.amazonaws.com
VITE_COGNITO_AUTHORITY=https://cognito-idp.us-west-2.amazonaws.com/us-west-2_CHANGEME
VITE_COGNITO_CLIENT_ID=CHANGEME
VITE_COGNITO_DOMAIN=jobtracker-CHANGEME.auth.us-west-2.amazoncognito.com

# VITE_REDIRECT_URL is not set — auth/config.ts falls back to window.location.origin,
# which works for both `npm run dev` (localhost:5173) and the deployed CloudFront URL
# without rebuilding the bundle.